# Copier vers .env.local. Toute variable listée ici est validée dans src/env.ts.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Aucun envoi d'email réel hors production (défaut : true hors prod).
EMAIL_DRY_RUN=true
# Supabase (tableau de bord > Project Settings > API, ou `supabase start` en local).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
