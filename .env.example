# Copier vers .env.local. Toute variable listée ici est validée dans src/env.ts.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Aucun envoi d'email réel hors production (défaut : true hors prod).
EMAIL_DRY_RUN=true
# Supabase (tableau de bord > Project Settings > API, ou `supabase start` en local).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Variables secrètes, optionnelles pour le build (erreur claire à l'usage si absentes).
# Clé service_role Supabase : serveur uniquement, jamais exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=
# Inngest : en local, INNGEST_DEV=1 (puis `pnpm inngest:dev`) ; en production, les deux clés.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# DataForSEO (https://app.dataforseo.com/api-access) : optionnels, requis seulement pour les audits.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# true uniquement si un proxy injecte l'authentification (dev agent) ; jamais en production.
DATAFORSEO_PROXY_AUTH=false
# Lecteur de pages de secours du tri des cibles : none (défaut) ou jina (r.jina.ai).
PAGE_READER_FALLBACK=none
# Finder et vérificateur d'emails (M3.2, optionnels) : hunter ; sans clé, aucun email n'est envoyable.
# EMAIL_FINDER_PROVIDER=hunter
# EMAIL_FINDER_API_KEY=
# Vérification gratuite (DNS/MX) des emails publiés par la cible : mx (défaut) ou none.
EMAIL_FREE_VERIFY=mx
# LLM (optionnels, requis seulement pour le résumé d'audit) : Anthropic est la cible, OpenAI sert au dev.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_PROVIDER=anthropic
# LLM_MODEL=
# true uniquement si un proxy injecte l'authentification OpenAI (dev agent) ; jamais en production.
LLM_PROXY_AUTH=false
# Audit gratuit public (M1.6) : interrupteur et plafond de dépense journalier (USD, DataForSEO + LLM).
PUBLIC_AUDIT_ENABLED=true
PUBLIC_AUDIT_DAILY_CAP_USD=3
# Sel du hachage des IP (anti-abus) ; à défaut, dérivé de SUPABASE_SERVICE_ROLE_KEY.
# ABUSE_HASH_SALT=
# Stripe (M6.1) : clés de TEST seulement. Sans clé : adaptateur factice.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LOG_LEVEL=info
# Mode bêta : limites de volume levées (niveau payant pour tous), plafonds de coût conservés.
BETA_MODE=false
# Plafond de sécurité des dépenses d'API sur 24 h glissantes, toute la plateforme (USD).
DAILY_COST_CAP_USD=25
# Second garde d'envoi réel d'emails (avec EMAIL_DRY_RUN). Laisser false.
OUTREACH_SENDING_ENABLED=false
