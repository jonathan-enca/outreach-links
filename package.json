{
  "name": "outreach-backlinks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:dataforseo": "DATAFORSEO_LIVE_DEMO=1 vitest run src/lib/dataforseo/demo.live.test.ts",
    "demo:audit": "AUDIT_LIVE_DEMO=1 vitest run src/features/audits/validation.live.test.ts",
    "demo:public-audit": "PUBLIC_AUDIT_LIVE_DEMO=1 vitest run src/features/public-audit/measure.live.test.ts",
    "demo:triage": "TRIAGE_LIVE_EVAL=1 vitest run src/features/triage/eval.live.test.ts",
    "demo:replies": "REPLIES_LIVE_EVAL=1 vitest run src/features/classification/eval.live.test.ts",
    "demo:onboarding": "ONBOARDING_LIVE_DEMO=1 vitest run src/features/onboarding/deduce.live.test.ts",
    "demo:brand": "BRAND_LIVE_DEMO=1 vitest run src/features/brand/brand.live.test.ts",
    "demo:collect": "COLLECT_LIVE_DEMO=1 vitest run src/features/collection/collection.live.test.ts",
    "demo:queries": "QUERIES_LIVE_DEMO=1 vitest run src/features/queries/queries.live.test.ts",
    "demo:llm": "LLM_LIVE_DEMO=1 vitest run src/features/profile/summary.live.test.ts",
    "inngest:dev": "npx --yes --ignore-scripts=false inngest-cli@1.53.0 dev -u http://localhost:3000/api/inngest --no-discovery",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts && prettier --write src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "imapflow": "^2.11.0",
    "inngest": "^4.26.2",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/smtp-server": "^3.5.13",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "mailparser": "^3.14.3",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "smtp-server": "^3.21.4",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.28.0"
}
